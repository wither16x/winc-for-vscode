{
  "name": "winc-for-vscode",
  "displayName": "Winc for VSCode",
  "description": "VSCode support for the Winc programming language.",
  "version": "0.0.1",
  "publisher": "wither16x",
  "author": {
    "name": "Wither__",
    "url": "https://github.com/wither16x"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wither16x/winc"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "winc",
      "aliases": ["Winc", "winc"],
      "extensions": [".wc"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "winc",
      "scopeName": "source.wc",
      "path": "./syntaxes/winc.tmLanguage.json"
    }]
  },
  "keywords": [
    "winc"
  ]
}
