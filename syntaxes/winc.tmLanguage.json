{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Winc",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#chars"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.winc",
					"match": "//.*$"
				},
				{
					"name": "comment.block.winc",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.winc",
				"match": "\\b(if|else|while|for|return|import|switch|case|default|break|continue|true|false|typedef)\\b"
			},
			{
				"name": "storage.modifier.winc",
				"match": "\\b(pub|extern|const|unsigned|inline|volatile|static|noreturn|restrict|struct|union|signed|enum)\\b"
			},
			{
				"name": "storage.type.winc",
				"match": "\\b(char|short|int|long|void|u8|u16|u32|u64|s8|s16|s32|s64|usize|ssize|bool|float|double)\\b"
			},
			{
				"name": "keyword.operator.sizeof.winc",
				"match": "\\b(sizeof|typeof)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.winc",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.winc",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.winc",
					"match": "\\b0[xX][0-9a-fA-F_]+\\b"
				},
				{
					"name": "constant.numeric.binary.winc",
					"match": "\\b0[bB][01_]+\\b"
				},
				{
					"name": "constant.numeric.float.winc",
					"match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.winc",
					"match": "\\b\\d[\\d_]*\\b"
				}
			]
		},
		"chars": {
			"name": "string.quoted.single.winc",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.winc",
					"match": "\\\\."
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.winc",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.winc",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		}
	},
	"scopeName": "source.wc"
}